# GitHub.com token for private repositories.
GITHUB_TOKEN=

# GitHub Enterprise token for self-hosted GitHub-compatible deployments.
GHE_TOKEN=

# Optional API base URL override for non-standard GitHub Enterprise routing.
# Example: https://ghe.example.com/api/v3
PR_RADAR_GITHUB_API_BASE_URL=

# Optional name of the environment variable containing the token.
# The value must be an env var name, not a token secret.
PR_RADAR_GITHUB_TOKEN_ENV=
